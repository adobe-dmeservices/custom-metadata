    "prefix": "prs",
    "namespace": "http://prismstandard.org/namespaces/prs/3.1",
    "propertyName": "permission",
    "type": "Structure",
    "arrayType": "bag",
    "dependencies": [],
    "readOnly": false,
    "disabled": false,
    "structure": {
      "isArray": true,
      "fields": [
        {
          "id": "prismrs-permission-action",
          "displayName": "Action",
          "prefix": "prs",
          "namespace": "http://prismstandard.org/namespaces/prs/3.1",
          "propertyName": "action",
          "type": "MultiDropdown",
          "arrayType": "bag",
          "dependencies": [],
          "readOnly": false,
          "options": [
            { "value": "use", "label": "Use" },
            { "value": "presentDisplay", "label": "Present -- Display" },
            { "value": "presentPlay", "label": "Present -- Play" },
            { "value": "presentPrint", "label": "Present -- Print" },
            { "value": "presentTextToSpeech", "label": "Present -- Text to Speech" },
            { "value": "aggregate", "label": "Aggregate" },
            { "value": "translate", "label": "Translate" },
            { "value": "transform", "label": "Transform" }
          ],
          "customToolTip": "The action(s) this permission grants."
        },
        {
          "id": "prismrs-permission-duty",
          "displayName": "Duty",
          "prefix": "prs",
          "namespace": "http://prismstandard.org/namespaces/prs/3.1",
          "propertyName": "duty",
          "type": "MultiDropdown",
          "arrayType": "bag",
          "dependencies": [],
          "readOnly": false,
          "options": [
            { "value": "credit", "label": "Credit" },
            { "value": "compensate", "label": "Compensate" },
            { "value": "inform", "label": "Inform" },
            { "value": "include", "label": "Include" }
          ],
          "customToolTip": "Action(s) a publisher must take in order to have permission to use the asset (for example, giving credit)."
        },
        {
          "id": "prismrs-permission-constraintName",
          "displayName": "Constraint Name",
          "prefix": "prs",
          "namespace": "http://prismstandard.org/namespaces/prs/3.1",
          "propertyName": "constraintName",
          "type": "Text",
          "dependencies": [],
          "readOnly": false,
          "multiLine": false,
          "customToolTip": "The name of a limit placed on this permission's action (for example, \"dateTime\" or \"industry\")."
        },
        {
          "id": "prismrs-permission-constraintOperator",
          "displayName": "Constraint Operator",
          "prefix": "prs",
          "namespace": "http://prismstandard.org/namespaces/prs/3.1",
          "propertyName": "constraintOperator",
          "type": "Text",
          "dependencies": [],
          "readOnly": false,
          "multiLine": false,
          "customToolTip": "The comparison operator for the constraint (for example, \"lt\", \"gt\", \"eq\")."
        },
        {
          "id": "prismrs-permission-rightOperand",
          "displayName": "Right Operand",
          "prefix": "prs",
          "namespace": "http://prismstandard.org/namespaces/prs/3.1",
          "propertyName": "rightOperand",
          "type": "Text",
          "dependencies": [],
          "readOnly": false,
          "multiLine": false,
          "customToolTip": "The value the constraint is compared against."
        },
        {
          "id": "prismrs-permission-datatype",
          "displayName": "Datatype",
          "prefix": "prs",
          "namespace": "http://prismstandard.org/namespaces/prs/3.1",
          "propertyName": "datatype",
          "type": "Text",
          "dependencies": [],
          "readOnly": false,
          "multiLine": false,
          "customToolTip": "The datatype of the Right Operand value (for example, \"date\" or \"string\")."
        }
      ]
    },
    "customToolTip": "A permission statement indicating the action(s) permitted, any constraints that must be applied, and any duties that must be performed. The full spec also allows associating one or more Parties with each duty -- add matching entries under Party above and cross-reference them by name."
  },
